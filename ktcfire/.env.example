# Copy to .env.local for local development. On Vercel, set these under
# Project → Settings → Environment Variables. Never commit real values.

# Resend API key (server-side only, never exposed to the browser).
# Create at https://resend.com → API Keys → "Create API Key".
# IMPORTANT: register the Resend account with the design@ktcfire.com inbox —
# without a verified sending domain, Resend only delivers to the account
# owner's own address. See EMAIL-SETUP.md.
RESEND_API_KEY=

# Where form submissions are delivered. Defaults to design@ktcfire.com if unset.
CONTACT_TO_EMAIL=design@ktcfire.com

# The From header. Must be a sender Resend accepts; the default onboarding
# sender works without any domain setup. Defaults to the value below if unset.
CONTACT_FROM_EMAIL="KTC Fire Website <onboarding@resend.dev>"
